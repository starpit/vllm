# Multi-stage build for vLLM Rust (CPU only)
# Usage: docker build -f Dockerfile.cpu -t vllm-rs:cpu .

# --- Builder stage ---
FROM rust:1.87-slim AS builder

WORKDIR /build
COPY . .

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
RUN cargo build --release -p vllm-cli

# --- Runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/vllm /usr/local/bin/vllm

EXPOSE 8000

ENTRYPOINT ["vllm"]
CMD ["serve", "--help"]
