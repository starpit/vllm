# syntax=docker/dockerfile:1.7
#
# Builds a vllm-rs CUDA runtime image on top of vllm-rs-base.
# No GPU required on the build machine — nvcc compiles device code ahead of time.
#
# Prerequisites:
#   docker build -t vllm-rs-base:cuda12.9 -f Dockerfile.cuda-base .
#
# Build (from vllm-rs/):
#   docker build -t vllm-rs:sm89 --build-arg CUDA_COMPUTE_CAP=89 .
#
# The binary layer is ~262MB on top of the shared vllm-rs-base (~1.4GB).
# Different SM builds share the same base layer in the registry.

# =============================================================================
# Stage 1: Builder base — full CUDA toolkit, no GPU needed at build time
# =============================================================================
FROM nvidia/cuda:12.9.1-devel-ubuntu22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# cublas headers + shared libs are already present in the -devel image

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

RUN cargo install cargo-chef --locked

# =============================================================================
# Stage 2: Dependency plan — reruns only when Cargo.toml / Cargo.lock changes
# =============================================================================
FROM builder AS planner
WORKDIR /build
COPY . .
RUN cargo chef prepare --recipe-path recipe.json --bin vllm

# =============================================================================
# Stage 3: Dependency compilation — cached layer
# =============================================================================
FROM builder AS cooker
WORKDIR /build
COPY --from=planner /build/recipe.json recipe.json
COPY third_party/ third_party/
RUN cargo chef cook --release --features cuda,nccl --recipe-path recipe.json --bin vllm

# =============================================================================
# Stage 4: CUDA kernel compilation
# Only invalidates when .cu sources, third_party/, or build.rs change.
# Independent of all Rust source changes.
# =============================================================================
FROM builder AS kernel-builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
# Cargo requires all workspace member Cargo.toml files to be present.
# Copy stub crates (Cargo.toml only, no src/) for every member except vllm-kernels-cuda.
COPY crates/vllm-common/Cargo.toml crates/vllm-common/Cargo.toml
COPY crates/vllm-config/Cargo.toml crates/vllm-config/Cargo.toml
COPY crates/vllm-core/Cargo.toml crates/vllm-core/Cargo.toml
COPY crates/vllm-engine/Cargo.toml crates/vllm-engine/Cargo.toml
COPY crates/vllm-serve/Cargo.toml crates/vllm-serve/Cargo.toml
COPY crates/vllm-executor/Cargo.toml crates/vllm-executor/Cargo.toml
COPY crates/vllm-model/Cargo.toml crates/vllm-model/Cargo.toml
COPY crates/vllm-protocol/Cargo.toml crates/vllm-protocol/Cargo.toml
COPY crates/vllm-pyo3/Cargo.toml crates/vllm-pyo3/Cargo.toml
COPY crates/vllm-bench/Cargo.toml crates/vllm-bench/Cargo.toml
COPY crates/vllm-cli/Cargo.toml crates/vllm-cli/Cargo.toml
COPY crates/vllm-mlx/Cargo.toml crates/vllm-mlx/Cargo.toml
COPY crates/vllm-e2e/Cargo.toml crates/vllm-e2e/Cargo.toml
COPY crates/vllm-wgpu/Cargo.toml crates/vllm-wgpu/Cargo.toml
COPY crates/vllm-cuda/Cargo.toml crates/vllm-cuda/Cargo.toml
COPY crates/vllm-examples/Cargo.toml crates/vllm-examples/Cargo.toml
COPY crates/vllm-parity/Cargo.toml crates/vllm-parity/Cargo.toml
COPY crates/vllm-gce/Cargo.toml crates/vllm-gce/Cargo.toml
# The real crate — full source
COPY crates/vllm-kernels-cuda/ crates/vllm-kernels-cuda/
COPY crates/vllm-cuda/csrc/ crates/vllm-cuda/csrc/
COPY third_party/ third_party/
ARG CUDA_COMPUTE_CAP=89
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}
RUN cargo build -p vllm-kernels-cuda --features cuda --release

# =============================================================================
# Stage 5: Binary compilation
# =============================================================================
FROM builder AS compiler
WORKDIR /build

COPY . .

# Reuse pre-built deps from cooker and pre-compiled kernels from kernel-builder
COPY --from=cooker /build/target target
COPY --from=cooker /root/.cargo /root/.cargo
COPY --from=kernel-builder /root/.cache/cudaforge /root/.cache/cudaforge

# Target a specific GPU architecture to avoid compiling kernels for every SM.
# Common values: 80 (A100), 86 (A10/A30), 89 (L40S/RTX 4090), 90 (H100).
# Defaults to the current machine's GPU if unset (may not work in CI — set explicitly).
ARG CUDA_COMPUTE_CAP=89
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}

RUN cargo build --release --features cuda,nccl -p vllm-cli

# Sanity check: libcudart must NOT appear (statically linked).
# libcublas/libcublasLt are expected dynamic deps.
RUN echo "=== Dynamic deps ===" && ldd target/release/vllm && \
    ldd target/release/vllm | grep "libcudart" \
    && echo "FAIL: libcudart is dynamic — static link broke" && exit 1 || true

# =============================================================================
# Stage 6: Runtime image — thin layer on top of shared base
# =============================================================================
FROM vllm-rs-base:cuda12.9

COPY --from=compiler /build/target/release/vllm /usr/local/bin/vllm

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/vllm"]
CMD ["serve", "--help"]
