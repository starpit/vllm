# Multi-stage build for vLLM Rust (CUDA)
# Usage: docker build -f Dockerfile.cuda -t vllm-rs:cuda .

# --- Builder stage ---
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder

RUN apt-get update && apt-get install -y curl build-essential pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY . .

RUN cargo build --release -p vllm-cli

# --- Runtime stage ---
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/vllm /usr/local/bin/vllm

EXPOSE 8000

ENTRYPOINT ["vllm"]
CMD ["serve", "--help"]
