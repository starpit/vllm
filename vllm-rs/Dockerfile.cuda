# syntax=docker/dockerfile:1.7
#
# Builds a minimal CUDA runtime image for vllm-rs.
# No GPU required on the build machine — nvcc compiles device code ahead of time.
#
# Build (from repo root):
#   docker buildx build --platform linux/amd64 \
#     -t vllm-rs:cuda -f vllm-rs/Dockerfile.cuda .
#
# Runtime deps in the final image:
#   libcublas.so.12 + libcublasLt.so.12  — ~500MB; dynamic to avoid 1.1GB binary
#   libnccl.so.2                          — ~120MB; drop with --features cuda (no nccl)
#   libcuda.so.1                          — NOT in image; injected by nvidia-container-toolkit
#   libcudart.so                          — NOT in image; statically linked into binary
#
# Final image size: ~650MB with NCCL, ~550MB without.

# =============================================================================
# Stage 1: Builder base — full CUDA toolkit, no GPU needed at build time
# =============================================================================
FROM nvidia/cuda:12.9.1-devel-ubuntu22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# cublas headers + shared libs are already present in the -devel image

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

RUN cargo install cargo-chef --locked

# =============================================================================
# Stage 2: Dependency plan — reruns only when Cargo.toml / Cargo.lock changes
# =============================================================================
FROM builder AS planner
WORKDIR /build
COPY vllm-rs/ .
RUN cargo chef prepare --recipe-path recipe.json --bin vllm-cli

# =============================================================================
# Stage 3: Dependency compilation — cached layer
# =============================================================================
FROM builder AS cooker
WORKDIR /build
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release --features cuda,nccl --recipe-path recipe.json --bin vllm-cli

# =============================================================================
# Stage 4: Binary compilation
# =============================================================================
FROM builder AS compiler
WORKDIR /build

COPY vllm-rs/ .
COPY third_party/ ../third_party/

# Reuse pre-built deps from cooker
COPY --from=cooker /build/target target
COPY --from=cooker /root/.cargo /root/.cargo

RUN cargo build --release --features cuda,nccl -p vllm-cli

# Sanity check: libcudart must NOT appear (statically linked).
# libcublas/libcublasLt are expected dynamic deps.
RUN echo "=== Dynamic deps ===" && ldd target/release/vllm && \
    ldd target/release/vllm | grep "libcudart" \
    && echo "FAIL: libcudart is dynamic — static link broke" && exit 1 || true

# =============================================================================
# Stage 5: Minimal runtime image
# =============================================================================
FROM debian:12-slim

# libcublas + libcublasLt: dynamic deps (~500MB combined).
# libnccl2: multi-GPU tensor parallelism (~120MB). Drop for single-GPU builds.
# ca-certificates: needed for HuggingFace Hub HTTPS downloads.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcublas12 \
    libnccl2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=compiler /build/target/release/vllm /usr/local/bin/vllm

# nvidia-container-toolkit mounts libcuda.so.1 from the host driver at container
# start when NVIDIA_VISIBLE_DEVICES is set — no CUDA libs needed in the image.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/vllm"]
CMD ["serve", "--help"]
